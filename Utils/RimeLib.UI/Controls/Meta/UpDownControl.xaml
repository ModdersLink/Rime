<UserControl x:Class="RimeLib.UI.Controls.Meta.UpDownControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RimeLib.UI.Controls.Meta"
             mc:Ignorable="d" Width="448" Height="54">
    <Grid Margin="0,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Example Text" Width="Auto" TextAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0"/>
        <TextBox DataContext="{Binding Value}" Text="0.0" VerticalAlignment="Center" Grid.Column="1" Grid.Row="0"/>
        <Grid Grid.Column="2" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="30"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Content="+" Grid.Row="0"/>
            <Button Content="-" Grid.Row="1"/>
        </Grid>
        <!--<StackPanel Orientation="Horizontal">
            <TextBlock Text="Example Text" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <TextBox DataContext="{Binding ElementName=_this, Path=Value}" Text="0.0"/>
            <StackPanel Orientation="Vertical">
                <Button Content="+"/>
                <Button Content="-"/>
            </StackPanel>
        </StackPanel>-->
    </Grid>
</UserControl>
