<UserControl x:Class="RimeLib.UI.Controls.Meta.Vec2Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RimeLib.UI.Controls.Meta"
             xmlns:rui="clr-namespace:RimeLib.UI.ViewModels.fb"
             mc:Ignorable="d" Height="21" Width="738">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type rui:Vec2ViewModel}">
            
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Text="Example Text" Padding="0, 0, 5, 0"/>
        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBlock Background="Red" Text="X" TextAlignment="Center" VerticalAlignment="Center" Grid.Column="0"/>
            <TextBox Text="{Binding Path=X, Mode=TwoWay}" VerticalAlignment="Center" Grid.Column="1"/>
            <TextBlock Background="Green" Text="Y" TextAlignment="Center" VerticalAlignment="Center" Grid.Column="2"/>
            <TextBox Text="{Binding Path=Y, Mode=TwoWay}" VerticalAlignment="Center" Grid.Column="3"/>
            <Button Content="Revert" Grid.Column="4" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
