<UserControl x:Class="RimeLib.UI.Controls.Meta.Vec3Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RimeLib.UI.Controls.Meta"
             mc:Ignorable="d" Height="21" Width="738">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Example Text"/>
        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <TextBlock Background="Red" Text="X" TextAlignment="Center" VerticalAlignment="Center" Grid.Column="0"/>
            <TextBox Text="0.0" VerticalAlignment="Center" Grid.Column="1"/>
            <TextBlock Background="Green" Text="Y" TextAlignment="Center" VerticalAlignment="Center" Grid.Column="2"/>
            <TextBox Text="0.0" VerticalAlignment="Center" Grid.Column="3"/>
            <TextBlock Background="Blue" Text="Z" TextAlignment="Center" VerticalAlignment="Center" Grid.Column="4"/>
            <TextBox Text="0.0" VerticalAlignment="Center" Grid.Column="5"/>
            <Button Content="Revert" Grid.Column="7"/>
        </Grid>
    </Grid>
</UserControl>
