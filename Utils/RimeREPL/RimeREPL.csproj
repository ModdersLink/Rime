<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>default</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Rime.Utils.RimeREPL</RootNamespace>
    <OutputPath>$(SolutionDir)\bin\$(Configuration)</OutputPath>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Platforms>AnyCPU</Platforms>
    <Configurations>Release;Debug</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\RimeLib.Cmd\RimeLib.Cmd.csproj" />
  </ItemGroup>

  <!--
    The engine assemblies are found in the output directory at runtime rather than referenced, so
    building the REPL alone used to leave them as another branch built them. Build every one of
    them with it, and remove those whose project no longer exists: a branch's engine assembly that
    outlives the branch breaks mounting.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\RimeLib.*\*.csproj" Exclude="..\..\RimeLib.Cmd\RimeLib.Cmd.csproj;..\..\RimeLib.Tests\*.csproj;..\..\RimeLib.Partition\*.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <Target Name="RemoveOrphanedEngineAssemblies" AfterTargets="Build">
    <ItemGroup>
      <_EngineAssembly Include="$(OutDir)RimeLib.*.dll" />
      <_OrphanedEngineAssembly Include="@(_EngineAssembly)" Condition="!Exists('$(SolutionDir)%(Filename)/%(Filename).csproj')" />
    </ItemGroup>
    <Delete Files="@(_OrphanedEngineAssembly);@(_OrphanedEngineAssembly->'%(RootDir)%(Directory)%(Filename).pdb');@(_OrphanedEngineAssembly->'%(RootDir)%(Directory)%(Filename).deps.json')" />
    <Message Importance="high" Condition="'@(_OrphanedEngineAssembly)' != ''" Text="Removed engine assemblies without a project: @(_OrphanedEngineAssembly->'%(Filename)', ', ')" />
  </Target>

</Project>
