enum ShaderTextureCoordType {
	ShaderTextureCoordType_Unknown = 0,
	ShaderTextureCoordType_VertexElement = 1,
	ShaderTextureCoordType_WorldPos = 2
};
    
struct Vec4 {
    float x;
    float y;
    float z;
    float w;    
};

struct RawColor {
    float R;
    float G;
    float B;
    float A;    
};

struct TextureConstant {
    ubyte index;
    TextureType textureType;
    FSkip(0x6);
    char name[0x80];
    FSkip(0x10);
};

struct ExternalValueConstant {
    char name[0x20];
    uint handle;
    ushort index;
    ushort arraySize;
    ubyte size;
    byte required;
    FSkip(2);
    Vec4 defaultValue;
};

struct ExternalTextureConstant {
    char name[0x20];
    uint handle;
    ushort index;
    TextureType textureType;
    byte required;
};

struct SamplerStateDescription {
    Filter filter;
    TextureAddressMode addressU;
    TextureAddressMode addressV;
    TextureAddressMode addressW;
    float mipLodBias;
    int maximumAnisotropy;
    Comparison comparisonFunction;
    RawColor borderColor;
    float minimumLod;
    float maximumLod;
};

struct SamplerState {
    uint index;
    SamplerStateDescription desc;
    FSkip(8);
};

struct ShaderConstant {
    local long shaderConstantStartPosition = FTell() - 4;
    FSkip(4);

    uint64 valueConstantOffset;
    uint64 textureConstantOffset;
    uint64 externalValueConstantOffset;
    uint64 externalTextureConstantOffset;
    uint64 samplerStatesOffset;
    ushort constantCount;
    ushort valueConstantsCount;
    ubyte valueConstantCount;
    ubyte textureConstantCount;
    ubyte externalValueConstantCount;
    ubyte externalTextureConstantCount;
    ubyte samplerStateCount;
    
    if (valueConstantCount > 0) {
        FSeek(shaderConstantStartPosition + valueConstantOffset);
        Vec4 vec4[valueConstantCount] <optimize=false>;
    }
    
    if (textureConstantCount > 0) {
        FSeek(shaderConstantStartPosition + textureConstantOffset);
        TextureConstant textureConstant[textureConstantCount] <optimize=false>;
    }
    
    if (externalValueConstantCount > 0) {
        FSeek(shaderConstantStartPosition + externalValueConstantOffset);
        ExternalValueConstant externalValueConstant[externalValueConstantCount] <optimize=false>;
    }
    
    if (externalTextureConstantCount > 0) {
        FSeek(shaderConstantStartPosition + externalTextureConstantOffset);
        ExternalTextureConstant externalTextureConstant[externalTextureConstantCount] <optimize=false>;
    }
    
    if (samplerStateCount > 0) {
        FSeek(shaderConstantStartPosition + samplerStatesOffset);
        SamplerState samplers[samplerStateCount] <optimize=false>;
    }
};

struct ShaderConstantFunctionData {
    ushort constantsCount;
    ushort registerCount;
    if (constantsCount > 0) {
        struct Constant {
            ShaderConstantFunction function;
            FSkip(3);
            ubyte index;
            ubyte parameter;
            ubyte arraySize;
            ubyte vectorCount;
        } constants[constantsCount] <optimize=false>;
    }
};

struct ShaderTextureFunctionData {
    uint textureCount;
    if (textureCount > 0) {
        struct Texture {
            ShaderConstantFunction function;
            ShaderValueType valueType;
            ubyte index;
            ubyte parameter;
        } textures[textureCount] <optimize=false>;
    }
};

struct InputElement {
    int semanticIndex;
    Format format;
    int slot;
    int alignedByteOffset;
    InputClassification classification;
    int instanceDataStepRate;
};

struct VertexShaderPermutation {
    GUID guid;
    uint dataSize;
    byte shaderByteCode[dataSize] <optimize=false>;
    uint constantIndex;
    uint constantFunctionIndex;
    uint textureFunctionIndex;
    int bytecodeSize;
    byte inputSignatureBytecode[bytecodeSize] <optimize=false>;
    uint elementCount;
    InputElement elements[elementCount] <optimize=false>;
    uint elementNamesCount;
    struct String {
        string _;
    } elementNames[elementNamesCount] <optimize=false>;
    uint instructionCount;
};

struct PixelShaderPermutation {
    GUID guid;
    uint dataSize;
    byte shaderByteCode[dataSize] <optimize=false>;
    uint constantIndex;
    uint constantFunctionIndex;
    uint textureFunctionIndex;
    uint instructionCount;
    
};

struct GeometryShaderPermutation {
    GUID guid;
    uint dataSize;
    byte shaderByteCode[dataSize] <optimize=false>;
    uint instructionCount;
};

struct ShaderSolution {
    uint64 stateHash;
    ubyte flags;
    SurfaceShaderType surfaceShader;
    ShaderBlendMode blendMode;
    FSkip(0xD);
    int64 vertexPermutationIndex;
    int64 pixelPermutationIndex;
    int64 geometryPermutationIndex;
    int64 vertexConstantsIndex;
    int64 pixelConstantsIndex;
};

struct ShaderSolutionState {
    uint surfaceShaderNameHash;
    uint vertexShaderFragmentNameHash;
    uint geometryDeclarationHash;
    ShaderRenderMode mode;
    ShaderGeometrySpace geometrySpace;
    ShaderSkinningMethod skinningMethod;
    ShaderInstancingMethod instancingMethod;
    ShaderObjectLighting objectLightning;
    ubyte colorScale;
    ubyte technique;
    ubyte boolPermutation;
    ubyte ps3ClipPlaneCount;
    ubyte heightfieldTessellation;
    byte outdoorLightEnable;
    ShaderShadowmapMethod outdoorLightShadowmapMethod;
    ShaderShadowmapQuality outdoorLightShadowmapQuality;
    byte outdoorLightTransparencyShadowmapEnable;
    ubyte outdoorLightMultisampleCount;
    FSkip(0x5);
};

struct GeometryDeclarationDesc
{
    struct Element
    {
        VertexElementUsage usage;
        VertexElementFormat format;
        char offset;
        char streamIndex;
    };
    
    struct Stream
    {
        char stride;
        VertexElementClassification classification;    
    };

    Element elements[16] <optimize=false>;
    Stream streams[4] <optimize=false>;
    uchar elementCount;
    uchar streamCount;
    uchar padding_[2] <optimize=false>;
};

struct StreamableTexture {
    string name;
    ShaderTextureCoordType coordType;
    VertexElementUsage vertexUsage;
    FSkip(3);
    float factor;
};

struct StreamableExternalTexture {
    string parameterName;
    uint parameterId;
    ShaderTextureCoordType coordType;
    VertexElementUsage vertexUsage;
    FSkip(3);
    float factor;
};

struct SurfaceShaderInfo {
    uint key;
    SurfaceShaderType surfaceShaderType;
    FSkip(3);
    ubyte flags;
    ubyte boolParameterCount;
    ubyte boolParameterDefaultMask;
    ubyte boolParameterRequiredMask;
    uint boolParameterIds[8] <optimize=false>;
    uint streamableTexturesCount;
    StreamableTexture streamableTextures[streamableTexturesCount] <optimize=false>;
    uint streamableExternalTexturesCount;
    StreamableExternalTexture streamableExternalTextures[streamableExternalTexturesCount] <optimize=false>;
    uint solutionCount;
    ushort solutionIndices[solutionCount] <optimize=false>;
};

struct ShaderDatabase {
    uint version;
    ShaderRenderPath renderPath;
    uint constantsCount;
    local int j;
    local long pos;
    
    for (j = 0; j < constantsCount; j++) {
        uint shaderConstantSize;
        pos = FTell();
        ShaderConstant shaderConstants;
        FSeek(pos + shaderConstantSize - 4);
    }
    
    uint constantFunctionsCount;
    ShaderConstantFunctionData constantFunctions[constantFunctionsCount] <optimize=false>;
    uint textureFunctionCount;
    ShaderTextureFunctionData textureFunctions[textureFunctionCount] <optimize=false>;
    uint vertexShaderPermutationsCount;
    VertexShaderPermutation vertexShaderPermutations[vertexShaderPermutationsCount] <optimize=false>;
    uint pixelShaderPermutationsCount;
    PixelShaderPermutation pixelShaderPermutations[pixelShaderPermutationsCount] <optimize=false>;
    uint geometryShaderPermutationsCount;
    GeometryShaderPermutation geometryShaderPermutations[geometryShaderPermutationsCount] <optimize=false>;
    uint solutionCount;
    ShaderSolution solutions[solutionCount] <optimize=false>;
    uint solutionStateCount;
    ShaderSolutionState solutionStates[solutionStateCount] <optimize=false>;
    uint declarationCount;
    local uint k;
    for (k = 0; k < declarationCount; k++) {
        uint hash;
        GeometryDeclarationDesc desc;
    }
    uint shaderCount;
    SurfaceShaderInfo shaderInfo[shaderCount] <optimize=false>;
};

uint shaderRenderPaths;

local int i;
local long startPosition;
for (i = 0; i < shaderRenderPaths; i++) {
    ShaderRenderPath shaderPath;
    uint shaderDbSize;
    startPosition = FTell();
    
    ShaderDatabase shaderDb;
    
    FSeek(startPosition + shaderDbSize);
}