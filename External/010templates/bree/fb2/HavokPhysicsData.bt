uint align(uint bytes)
{
    local uint alignment = FTell();
    local uint i = 0;
    while (alignment % bytes != 0)
    {
        FSkip(1);
        i = i + 1;
        alignment = FTell();
    }
    return i;
}

struct Vec3 {
    float x;
    float y;
    float z;
    float pad;
};
struct Vec4 {
    float x;
    float y;
    float z;
    float w;
};

struct QSTransform {
    Vec3 left;
    Vec3 up;
    Vec3 forward;
};

struct AxisAlignedBox {
    Vec3 min;
    Vec3 max;
};

struct hkPackfileHeader
{
    int Magic[2];
    int UserTag;
    int FileVersion;
    ubyte LayoutRules[4];
    int NumSections;
    int ContentsSectionIndex;
    int ContentsSectionOffset;
    int ContentsClassNameSectionIndex;
    int ContentsClassNameSectionOffset;
    char ContentsVersion[16];
    int Flags;
    int Pad;
};

struct hkPackfileSectionHeader
{
    char SectionTagData[20];
    int AbsoluteDataStart;
    int LocalFixupsOffset;
    int GlobalFixupsOffset;
    int VirtualFixupsOffset;
    int ExportsOffset;
    int ImportsOffset;
    int EndOffset;
};

struct hkDescriptor
{
    int Signature;
    ubyte Version;
    string Name;
};

struct hkDescriptorInfo
{
    int64 Offset;
    int Key;
};

enum <ubyte> ShapeDispatchTypeEnum
{
    CONVEX_IMPLICIT = 0,
    CONVEX = 1,
    HEIGHT_FIELD = 2,
    COMPOSITE = 3,
    USER = 4,
    NUM_DISPATCH_TYPES = 5
};

enum <ubyte> ShapeInfoCodecTypeEnum
{
    NULL_CODEC = 0,
    UFM358 = 1,
    MAX_NUM_CODECS = 16
};

enum <ubyte> CollectionType
{
    COLLECTION_LIST = 0,
    COLLECTION_EXTENDED_MESH = 1,
    COLLECTION_TRISAMPLED_HEIGHTFIELD = 2,
    COLLECTION_USER = 3,
    COLLECTION_SIMPLE_MESH = 4,
    COLLECTION_MESH_SHAPE = 5,
    COLLECTION_COMPRESSED_MESH = 6,
    COLLECTION_MAX = 7
};


struct hkBaseObject
{
    uint base; // might be 8 (maybe on 64bits?)
};

struct hkReferenceObject
{
    hkBaseObject super;
    uint memSizeAndRefCount;
};

struct hkcdShape
{
    hkReferenceObject super;
    byte type;
    ShapeDispatchTypeEnum dispatchType;
    ubyte bitsPerKey;
    ShapeInfoCodecTypeEnum shapeInfoCodecType;
};

struct hkpShapeBase
{
    hkcdShape super;
};

struct hkpShape
{
    hkpShapeBase super;
    uint userData; // might be 8 (maybe on 64bits?)
};

struct hkpShapeCollection
{
    hkpShape super;
    uint pad0; // might be 8 (maybe on 64bits?) 
    byte disableWelding;
    CollectionType collectionType;
    ushort pad1; // might be 4 (maybe on 64bits?) 
};

struct hkpSphereRepShape
{
    hkpShape super;
};

struct hkpConvexShape
{
   hkpSphereRepShape super;
   float radius;
   // skip 4 on 64 bits
};

struct hkpBoxShape
{
    hkpConvexShape super;
    align(16);
    Vec4 halfExtents;
};

struct hkpShapeContainer
{
    uint base; // might be 8 (maybe on 64bits?)
};

struct hkpSingleShapeContainer
{
    hkpShapeContainer super;
    hkpShape childShape;
};

struct hkpConvexTransformShapeBase
{
    hkpConvexShape super;
    //hkpSingleShapeContainer childShape; // this should be a pointer
    uint childShapeSizeForSpu; // might be 8 (maybe on 64bits?)
};

struct hkpConvexTransformShape
{
    hkpConvexTransformShapeBase super;
    align(16);
    QSTransform transform;
    Vec4 extraScale;
};

struct hkpConvexTranslateShape
{
    hkpConvexTransformShapeBase super;
    align(16);
    Vec4 translation;
};

struct hkpCylinderShape
{
    hkpConvexShape super;
    float cylRadius;
    float cylBaseRadiusFactorForHeightFieldCollisions;
    align(16);
    Vec4 vertexA;
    Vec4 vertexB;
    Vec4 perpendicular1;
    Vec4 perpendiculat2;
};

struct hkpConvexVerticesShape
{
    hkpConvexShape super;
    align(16);
    Vec4 aabbHalfExtents;
    Vec4 aabbHalfCenter;
    uint relocPointer; //? TODO: finish
};

struct hkExtendedMeshHeader
{
    byte UnknownNull[21];
    ubyte U1;
    byte UnknownNull2[11];
    ubyte U2;
    int64 UnknownNull3;
    ubyte U3;
    byte U4Padding[83];
    int U4;
    int U5;
    int U6;
    int U7;
    short U8;
    Vec4 aabbHalfExtents;
    Vec4 aabbCenter;
    int materialClass;
    int numBitsForSubpartIndex;
    byte Null2[11];
    int U12;
    ubyte Null3;
    int IndexCount;
    short IndexCount2;
    ubyte Null4;
    int U14;
    int U15;
    int U16;
    int U17;
    int U18;
    ubyte U19;
    int U20;
    int U21;
    int Null5;
};

struct hkExtendedMeshEntry {
    Vec4 up;
    Vec4 right;
    Vec4 forward;
    Vec4 trans;
};

struct hkxRoot
{
    uint B1;
    uint EntryCount;
    uint B3;
    uint B4;
};

struct HavokPhysicsData {
    uint PartCount;
    int PartTranslationsCount;
    int64 PartTranslationsOffset;
    int LocalAabbsCount;
    int64 LocalAabbsOffset;
    int MaterialIndicesCount;
    int64 MaterialIndicesOffset;
    int MaterialFlagsAndIndicesCount;
    int64 MaterialFlagsAndIndicesOffset;
    int Scale;
    ubyte MaterialCountUsed;
    ubyte HighestMaterialIndex;
    ushort Padding;
} data;

uint RoundUp(uint bytes, uint a)
{
    FSkip(bytes);
    return bytes + align(a);
}

local uint s_PartTranslationsSize = RoundUp((data.PartTranslationsCount * /*sizeof(Vec3)*/ 16), 16);
local uint s_LocalAabsSize = RoundUp((data.LocalAabbsCount * /*sizeof(AxisAlignedBox)*/ 32), 16);
local uint s_MaterialIndicesSize = RoundUp((data.MaterialIndicesCount * /*sizeof(unsigned char)*/ 1), 16);
local uint s_MaterialFlagsAndIndicesSize = RoundUp((data.MaterialFlagsAndIndicesCount * /*sizeof(uint32_t)*/ 4), 16);
local uint s_HavokOffset = RoundUp(s_PartTranslationsSize + s_LocalAabsSize + s_MaterialIndicesSize + s_MaterialFlagsAndIndicesSize + 60, 16);

if (data.PartTranslationsCount > 0)
{
    FSeek(data.PartTranslationOffset);
    
    struct
    {
        Vec3 vec3[data.PartTranslationsCount];
    } PartTranslations;
}
if (data.LocalAabbsCount > 0)
{
    FSeek(data.LocalAabbsOffset);
    
    struct
    {
        AxisAlignedBox aabb[data.LocalAabbsCount];
    } LocalAabbs;
}
if (data.MaterialIndicesCount > 0)
{
    FSeek(data.MaterialIndicesOffset);
    
    struct
    {
        ubyte indices[data.MaterialIndicesCount];
    } MaterialIndices;
}
if (data.MaterialFlagsAndIndicesCount > 0)
{
    FSeek(data.MaterialFlagsAndIndicesOffset);
    
    struct
    {
        ushort flagsAndIndices[data.MaterialFlagsAndIndicesCount * 2];
    } MaterialFlagsAndIndices;
}

FSeek(s_HavokOffset);

struct {
    s_HavokOffset = FTell();
    hkPackfileHeader header;
    
    //hkPackfileSectionHeader sectionHeader[header.NumSections];
    hkPackfileSectionHeader classNamesSectionHeader;
    hkPackfileSectionHeader typesSectionHeader;
    hkPackfileSectionHeader dataSectionHeader;

    // __classnames__
    struct {
        local uint ClassNamesStart = s_HavokOffset + classNamesSectionHeader.AbsoluteDataStart;
        local uint ClassNamesEnd = ClassNamesStart + classNamesSectionHeader.EndOffset - 1;
        FSeek(ClassNamesStart);
        while (FTell() < ClassNamesEnd)
        {
            hkDescriptor descriptor;
        }
    } __classnames__;
    
    // ignore __types__ as EndOffset is 0.
    
    // __data__
    
    struct {
        local uint DataStart = s_HavokOffset + dataSectionHeader.AbsoluteDataStart;
        local uint DataEnd = DataStart + dataSectionHeader.EndOffset - 1;
        local uint DataFixupStart = DataStart + dataSectionHeader.VirtualFixupsOffset;
        local uint DataFixupEnd = DataStart + dataSectionHeader.ExportsOffset;
        local uint infoCount = 0;
        FSeek(DataStart);
        hkxRoot root;
        
        struct hkxRoot2
        {
            if (root.EntryCount > 0)
            {
                float Entries[root.EntryCount * 3];
            }
            else
            {
                float Entries[6]; // wrong for sure, just aligning.
            }
            string EntryName;
            align(16);
            string ClassName;
        } root2;
        
        struct hkxBlock
        {
            ushort Pad;
            uint B1;
            uint B2;
            uint B3;
            uint SkeletonCount;
            uint B5;
            uint B6;
            ushort AnimationCount;
            ushort B7;
            uint B8;
            uint B9;
            uint BindingsCount;
            uint B11;
            uint B12;
            uint AttachmentsCount;
            uint B14;
            uint B15;
            uint SkinsCount;
            int B17;
        } block;
        
        infoCount = (DataFixupEnd - DataFixupStart) / 12;
        
        FSeek(DataFixupStart);
        hkDescriptorInfo descriptorInfo[infoCount];
        
        local uint64 pos = FTell();
        
        for (int i=0; i < infoCount; i++)
        {
            if (descriptorInfo[i].Key != -1)
            {
                FSeek(s_HavokOffset + classNamesSectionHeader.AbsoluteDataStart + descriptorInfo[i].Key);
                struct String {
                    string _;    
                };
                String keyName;
                FSeek(DataStart + descriptorInfo[i].Offset);
                if (keyName._ == "hkpExtendedMeshShape")
                {
                    struct hkkk {
                        // hkReferenceObject
                        int memSizeAndRefCount;
                        // hkcdShape
                        byte type;
                        byte dispatchType;
                        byte bitsPerKey;
                        byte shapeInfoCodecType;
                        // hkpShapeBase
                        // hkpShape
                        uint64 userData;
                        // hkpShapeCollection
                        byte disableWelding;
                        uint64 collectionType;
                        
                        // hkpExtendedMeshShapeTrianglesSubpart
                        uint numTriangleShapes;
                        uint vertexBase;
                        int numVertices;
                        uint indexBase;
                        ushort vertexStriding;
                        int triangleOffset;
                        ushort indexStriding;
                        byte stridingType;
                        byte flipAlternateTriangles;
                        Vec4 extrusion;
                        Vec4 left;
                        Vec4 up;
                        Vec4 forward;
                        Vec4 trans;
                        
                        // hkpExtendedMeshShape
                        hfloat aabbHalfExtents_min_x; 
                        hfloat aabbHalfExtents_min_y; 
                        hfloat aabbHalfExtents_min_z; 
                        hfloat aabbHalfExtents_max_x; 
                        hfloat aabbHalfExtents_max_y; 
                        hfloat aabbHalfExtents_max_z; 
                    } ;
                    
                    hkExtendedMeshHeader meshHeader <bgcolor=0xFF0000>;
                    hkExtendedMeshEntry meshTransform[meshHeader.IndexCount] <bgcolor=0xFF0000>;
                }
                else if (keyName._ == "hkpBoxShape")
                {
                    hkpBoxShape boxShape;
                }
                else if (keyName._ == "hkpConvexTransformShape")
                {
                    hkpConvexTransformShape convexTransformShape;
                }
                else if (keyName._ == "hkpConvexTranslateShape")
                {
                    hkpConvexTranslateShape convexTranslateShape;
                }
                else if (keyName._ == "hkpCylinderShape")
                {
                    hkpCylinderShape cylinderShape;
                }
                else if (keyName._ == "hkpConvexVerticesShape")
                {
                    hkpConvexVerticesShape convexVerticesShape;
                }
                else if (keyName._ == "hkpCompressedMeshShape")
                {
                    hkpShapeCollection _compressedMeshShape; // TODO: finish
                }
                else if (keyName._ == "HavokPhysicsContainer")
                {
                    hkxRoot root <bgcolor=0xFF0000>;
                }
                else
                {
                    hkxRoot root <bgcolor=0xFF0000>;
                }
            }
        }
        FSeek(pos);
    } __data__;
    
    align(16);
} hk[2] <optimize=false>;

