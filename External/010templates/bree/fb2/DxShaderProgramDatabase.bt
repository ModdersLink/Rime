struct GeometryDeclarationDesc
{
    struct Element
    {
        VertexElementUsage usage;
        VertexElementFormat format;
        char offset;
        char streamIndex;
    };
    
    struct Stream
    {
        char stride;
        VertexElementClassification classification;    
    };

    Element elements[16] <optimize=false>;
    Stream streams[4] <optimize=false>;
    uchar elementCount;
    uchar streamCount;
    uchar padding_[2] <optimize=false>;
};

struct Shader
{
    string m_name;
    int m_shaderSize;
    byte m_shaderCode[m_shaderSize] <optimize=false>;
};

struct ShaderStage
{
    uint m_shaderCount;
    if (m_shaderCount != 0)
    {
        Shader m_shaders[m_shaderCount] <optimize=false>;
    }
};

struct VertexShader
{
    string m_name;
    int m_shaderSize;
    byte m_shaderCode[m_shaderSize] <optimize=false>;
    GeometryDeclarationDesc m_desc;
};

struct VertexShaderStage
{
    uint m_shaderCount;
    VertexShader m_shaders[m_shaderCount] <optimize=false>;
};

struct Permutation
{
    uint m_mask;
    uint m_index;
};

struct ShaderProgram
{
    ushort m_permutationCounts[6] <optimize=false>;
    ushort m_permutationOffsets[6] <optimize=false>;
};

struct DxShaderProgramDatabasePatch
{
    int m_renderPath;
    int m_size;
    VertexShaderStage m_vertexShaderStage;
    ShaderStage m_stages[5] <optimize=false>;
    ShaderProgram m_shaderPrograms[222] <optimize=false>;
    uint m_permutationCount;
    Permutation m_permutations[m_permutationCount] <optimize=false>;
};

struct DxShaderProgramDatabase
{
    uint m_patchCount;
    DxShaderProgramDatabasePatch m_patches[m_patchCount] <optimize=false>;
} dxShaderProgramDatabase <bgcolor=0xFF0000>;
