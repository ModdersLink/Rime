        //    uint m_lineSize[m_nodeSamplesPerSide] <optimize=false>;
        //};
    
        char m_hasChildren;
        // loadNodes x4
        // if hasChildren true
        //TerrainMaterialTreeNode m_childNodes[4];
    } m_nodes[m_nodeCount] <optimize=false>;

    ushort m_minHeightData[m_nodeSamplesPerSide * 2] <optimize=false>;

    byte rasterTreeLoad[rasterTreeLoadSize - 57 - (m_nodeSamplesPerSide * 4) - (m_nodeCount * 29)] <optimize=false>;
};

