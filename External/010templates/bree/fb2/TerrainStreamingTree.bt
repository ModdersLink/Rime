    float m_ps3RsxHeightfieldCacheFraction;
    uint m_minMaxStackDepth;
    uint m_occluderGridStackDepth;
    uint m_nodeCount;
    uint m_persistentNodeCount;
    uint m_persistentDedicatedServerNodeCount;
    uint m_nodeBorderWidth;

    // HeightfieldTreeNode
    // load nodes
    struct HeightfieldTreeNode
    {
        AxisAlignedBox m_boundingBox;
    
        char m_nodeDisabled;
        char m_pruned;

        // if both booleans are true it will add these 2 flags: CanBeStreamedIn & LockedForPersistent
        byte m_canBeStreamedIn;
        byte m_isPersistent;

        // handle reading if both are true
        // if m_canBeStreamedIn && m_isPersistent
        //if( m_canBeStreamedIn == 1 && m_isPersistent == 1 )
