struct TerrainStreamingTree
{
    uint m_unblurredSamplesPerNodeSidePot;
    char m_trackTextureDetailFalloff;
    float m_invisibleDetailReductionFactor;
    float m_occludedDetailReductionFactor;
    uint m_resourceBlurriness;
    uint m_nodeCount;
    char m_freeStreamingEnabled;
    HeightfieldTree m_heightfieldTree;
    TerrainMaskTree m_terrainMaskTree;
    TerrainColorTree m_terrainColorTree;
    TerrainMaterialTree m_terrainMaterialTree;
    DestructionDepthTree m_destructionDepthTree;

    byte pad; // no clue

    // loadNodes stuff
    struct TerrainStreamingTreeNode
    {
        uint m_lod0ChunkSize;
        GUID m_lod0ChunkID;
        byte m_lod1Enabled;

        if( m_lod1Enabled == 1 )
        {
            uint m_lod1ChunkSize;
            GUID m_lod1ChunkID;
        };

        char m_persistentDedicatedServer;
        char m_hasChildren;
    } m_nodes[m_nodeCount] <optimize=false>;
} m_terrainStreamingTree <bgcolor=0xFF0000>;
