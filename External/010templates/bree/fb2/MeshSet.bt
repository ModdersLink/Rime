enum <byte> VertexElementFormat
{
	VertexElementFormat_None = 0,
	VertexElementFormat_Float = 1,
	VertexElementFormat_Float2 = 2,
	VertexElementFormat_Float3 = 3,
	VertexElementFormat_Float4 = 4,
	VertexElementFormat_Half = 5,
	VertexElementFormat_Half2 = 6,
	VertexElementFormat_Half3 = 7,
	VertexElementFormat_Half4 = 8,
	VertexElementFormat_Byte4 = 10,
	VertexElementFormat_Byte4N = 11,
	VertexElementFormat_UByte4 = 12,
	VertexElementFormat_UByte4N = 13,
	VertexElementFormat_Short = 14,
	VertexElementFormat_Short2 = 15,
	VertexElementFormat_Short3 = 16,
	VertexElementFormat_Short4 = 17,
	VertexElementFormat_ShortN = 18,
	VertexElementFormat_Short2N = 19,
	VertexElementFormat_Short3N = 20,
	VertexElementFormat_Short4N = 21,
	VertexElementFormat_UShort2 = 22,
	VertexElementFormat_UShort4 = 23,
	VertexElementFormat_UShort2N = 24,
	VertexElementFormat_UShort4N = 25,
	VertexElementFormat_Int = 26,
	VertexElementFormat_Int2 = 27,
	VertexElementFormat_Int4 = 28,
	VertexElementFormat_IntN = 29,
	VertexElementFormat_Int2N = 30,
	VertexElementFormat_Int4N = 31,
	VertexElementFormat_UInt = 32,
	VertexElementFormat_UInt2 = 33,
	VertexElementFormat_UInt4 = 34,
	VertexElementFormat_UIntN = 35,
	VertexElementFormat_UInt2N = 36,
	VertexElementFormat_UInt4N = 37,
	VertexElementFormat_Comp3_10_10_10 = 38,
	VertexElementFormat_Comp3N_10_10_10 = 39,
	VertexElementFormat_UComp3_10_10_10 = 40,
	VertexElementFormat_UComp3N_10_10_10 = 41,
	VertexElementFormat_Comp3_11_11_10 = 42,
	VertexElementFormat_Comp3N_11_11_10 = 43,
	VertexElementFormat_UComp3_11_11_10 = 44,
	VertexElementFormat_UComp3N_11_11_10 = 45,
	VertexElementFormat_Comp4_10_10_10_2 = 46,
	VertexElementFormat_Comp4N_10_10_10_2 = 47,
	VertexElementFormat_UComp4_10_10_10_2 = 48,
	VertexElementFormat_UComp4N_10_10_10_2 = 49,
	VertexElementFormat_UByteN = 50,
	VertexElementFormat_Int3 = 51,
	VertexElementFormat_UInt3 = 52
};

struct GeometryDeclarationDesc
{
    struct Element
    {
        VertexElementUsage usage;
        VertexElementFormat format;
        char offset;
        char streamIndex;
    };
    
    struct Stream
    {
        char stride;
        VertexElementClassification classification;    
    };
    
    Element elements[16];
    Stream streams[4];
    char elementCount;
    char streamCount;
    ushort padding;  
};

struct MeshSubset
{
    uint64 geometryDeclarations;
    RelocPtr materialNameOffset;
    uint materialIndex;
    uint primitiveCount;
    uint startIndex;
    uint vertexOffset;
    uint vertexCount;
    char vertexStride;
    PrimitiveType primitiveType;
    char bonesPerVertex;
    char boneCount;
    RelocPtr boneIndicesOffset;
    GeometryDeclarationDesc geometryDeclarationDesc;
    float texCoordRatios[6];
    /*
    local uint64 pos = FTell();

    FSeek(materialNameOffset.Pointer);
    string materialName;
    
    FSeek(boneIndicesOffset.Pointer);
    ushort boneIndices[boneCount] <optimize=false>;
    
    FSeek(pos);*/
};

struct MeshLayout
{
    MeshType type;
    RelocArray subsetsOffset;
    RelocArray categorySubsetIndicesOffset[4];
    MeshLayoutFlags flags;
    IndexBufferFormat indexBufferFormat;
    uint indexDataSize;
    uint vertexDataSize;
    uint edgePartitionBufferSize;
    GUID dataChunkId;
    uint auxVertexIndexDataOffset;
    RelocPtr embeddedEdgeDataOffset;
    RelocPtr shaderDebugNameOffset;
    RelocPtr nameOffset;
    RelocPtr shortNameOffset;
    uint nameHash;
    uint64 data;
    uint partCount;
    RelocPtr boneIndexArrayPartBoundingBoxesOffset;
    RelocPtr boneShortNameArrayPartTransformsOffset;
    uint64 subsetPartIndices;
};

struct
{
    MeshType meshType;
    MeshLayoutFlags flags;
    uint lodCount;
    uint totalSubsetCount;
    AxisAlignedBox boundingBox;
    
    RelocPtr lodsOffset[5];
    RelocPtr nameOffset;
    RelocPtr shortNameOffset;

    uint nameHash;
    uint padding;
} MeshSet <bgcolor=0xFF0000>;

// use MeshSet.lodsOffset[i].Pointer instead;
MeshLayout lods[MeshSet.lodCount] <optimize=false,bgcolor=0xFF0000>;

local int i = 0;
local int j = 0;

struct Char // nobody knows why this is needed.
{
    char _;    
};
struct String // nobody knows why this is needed.
{
    string _;    
};
struct BoneCount // nobody knows why this is needed.
{
    ushort boneIndices[subsets[j].boneCount] <optimize=false,bgcolor=0xFF0000>;   
};
local uint64 pos = FTell();
struct {
    local uint alignment = 0;
    for (i = 0; i < MeshSet.lodCount; i++)
    {
        //FSeek(lods[i].subsetsOffset.Pointer);
        MeshSubset subsets[lods[i].subsetsOffset.Count] <optimize=false,bgcolor=0xFF0000>;
        
        pos = FTell();
        for (j = 0; j < lods[i].subsetsOffset.Count; j++)
        {
            FSeek(subsets[j].materialNameOffset.Pointer);
            String materialName <bgcolor=0xFF0000>;
            
            FSeek(subsets[j].boneIndicesOffset.Pointer);
            BoneCount boneIndices;
        }
        FSeek(pos);

        // align
        alignment = FTell();
        while (alignment % 16 != 0)
        {
            FSkip(1);
            alignment = FTell();
        }
    }
} subsets;

for (i = 0; i < MeshSet.lodCount; i++)
{
    //FSeek(lods[i].subsetsOffset.Pointer);
    for (j = 0; j < 4; j++)
    {
        if (lods[i].categorySubsetIndicesOffset[j].Count != 0)
        {
            FSeek(lods[i].categorySubsetIndicesOffset[j].Pointer);
            Char categorySubsetIndices[lods[i].categorySubsetIndicesOffset[j].Count] <optimize=false,bgcolor=0xFF0000>;
        }
    }
}

for (i = 0; i < MeshSet.lodCount; i++)
{
    if (lods[i].embeddedEdgeDataOffset.Pointer != 0)
    {
        FSeek(lods[i].embeddedEdgeDataOffset.Pointer);
        Char embeddedEdgeData <bgcolor=0xFF0000>;
    }
}
    
for (i = 0; i < MeshSet.lodCount; i++)
{
    if (lods[i].shaderDebugNameOffset.Pointer != 0)
    {
        FSeek(lods[i].shaderDebugNameOffset.Pointer);
        String shaderDebugName <bgcolor=0xFF0000>;
    }
}
    
for (i = 0; i < MeshSet.lodCount; i++)
{
    if (lods[i].nameOffset.Pointer != 0)
    {
        FSeek(lods[i].nameOffset.Pointer);
        String name <bgcolor=0xFF0000>;
    }
}
    
for (i = 0; i < MeshSet.lodCount; i++)
{
    if (lods[i].shortNameOffset.Pointer != 0)
    {
        FSeek(lods[i].shortNameOffset.Pointer);
        String shortName <bgcolor=0xFF0000>;
    }
}

FSeek(MeshSet.nameOffset.Pointer);
String name <bgcolor=0xFF0000>;

FSeek(MeshSet.shortNameOffset.Pointer);
String shortName <bgcolor=0xFF0000>;

struct BonePartBoundingBox // nobody knows why this is needed.
{
    uint boneIndexArrayPartBoundingBoxes[lods[i].partCount] <optimize=false,bgcolor=0xFF0000>;   
};
    
struct BonePartTransforms // nobody knows why this is needed.
{
    uint boneShortNameArrayPartTransforms[lods[i].partCount] <optimize=false,bgcolor=0xFF0000>;   
};

for (i = 0; i < MeshSet.lodCount; i++)
{
    if (lods[i].boneIndexArrayPartBoundingBoxesOffset.Pointer != 0)
    {
        FSeek(lods[i].boneIndexArrayPartBoundingBoxesOffset.Pointer);
        BonePartBoundingBox boneIndexArrayPartBoundingBoxes;
    }
    
    if (lods[i].boneShortNameArrayPartTransformsOffset.Pointer != 0)
    {
        FSeek(lods[i].boneShortNameArrayPartTransformsOffset.Pointer);
        BonePartTransforms boneShortNameArrayPartTransforms;
    }
}
