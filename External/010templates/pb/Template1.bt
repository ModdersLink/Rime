typedef struct {
    LONG Version;
    LONG Type;
    LONG Format;
    LONG Flags;
    SHORT Height;
    SHORT Width;
    SHORT Depth;
    SHORT SliceCount;
    SHORT Unused1;
    BYTE MipMapCount;
