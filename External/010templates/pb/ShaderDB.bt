typedef enum 
{
    ShaderRenderPath_Dx10, //0x0000
    ShaderRenderPath_Dx10Plus, //0x0001
    ShaderRenderPath_Dx10_1, //0x0002
    ShaderRenderPath_Dx11, //0x0003
    ShaderRenderPath_Dx11_1, //0x0004
    ShaderRenderPath_Xenon, //0x0005
    ShaderRenderPath_Ps3, //0x0006
    ShaderRenderPath_Gl, //0x0007
    ShaderRenderPath_Gen4a, //0x0008
    ShaderRenderPath_Gen4b, //0x0009
    ShaderRenderPathCount //0x000A
} ShaderRenderPath;

typedef struct
{
    uint32 permutationCounts[6]; // 6
    uint32 permutationOffsets[6]; // 6
} ProgramInfo;
 
typedef struct 
{
    uint32 mask;
    uint32 index;
} PermutationInfo;

typedef struct
{
    uint32 shaderCount;
    //for shaderCount
    local int i3 = 0;
} Stage;

typedef struct {
    local int StartPos = FTell();
    string debugName;
    uint32 ShaderSize;
    byte shader[ShaderSize];
} Shader;
typedef struct {
    byte meta[76];
} ShaderMeta;
typedef struct 
{
    uint32 pathCount;
 
    local int i = 0;
    for(i=0; i< pathCount; i++)
    {
        ShaderRenderPath path;
        uint32 size;
        
        local int i2 = 0;
        //for stage in ShaderStageTypeCount // 6
        for(i2=0; i2< pathCount; i2++)
        {
            Stage s;

            
            for(s.i3=0; s.i3< s.shaderCount; s.i3++)
            {
                Shader shader;
                if(i2 == 0) {
                    ShaderMeta meta;
                }
            }
        }
 
        ProgramInfo programs[s.shaderCount]; // 203 in beta, 222 in release
        uint32 permutationCount;
        PermutationInfo permutations[permutationCount];
    }
} DxShaderProgramDatabase;
DxShaderProgramDatabase sdb;