//------------------------------------------------
//--- 010 Editor v8.0 Binary Template
//
//      File: .hknodestruction
//   Authors: Powback
//   Version: 1
//   Purpose: To convert HKX files into a readable format.
//  Category: 
// File Mask: *.hknodestruction
//  ID Bytes: 57 E0 E0 57
//   History: 
//------------------------------------------------
LittleEndian();
local int StartOffset = 0;
local int CurrentPos = FTell();
typedef struct {
    UINT CurrentBytes;
    while(CurrentBytes != 0x57E0E057) {
        UINT CurrentBytes;
        StartOffset = FTell();
        StartOffset -= 4;
    }
    FSeek(StartOffset);
} Junk;


typedef struct {
    uint Magic1;
    uint Magic2;
    uint UserTag;
    uint FileVersion;
    uint LayoutRules;
    uint NumSections;
    uint ContentsSectionIndex;
    uint ContentsSectionOffset;
    uint ContentsClassNameSectionIndex;
    uint ContentsClassNameSectionOffset;
    string ContentsVersion;
    BYTE DeLimiter;
    uint Flags;
    uint Padding;
} HkxHeader;

typedef struct {
    BYTE SectionTag[19];
    BYTE NullByte;
    INT32 AbsoluteDataStart;
    INT32 LocalFixupsOffset;
    INT32 GlobalFixupsOffset;
    INT32 VirtualFixupsOffset;
    INT32 ExportsOffset;
    INT32 ImportsOffset;
    INT32 EndOffset;

} Section;

typedef struct 
{
    local int key = FTell() - StartOffset - classDataStart + 5;
    LONG Signature; // We need to store this
    BYTE Version;
    string Name;
    local int64 pos = FTell();
    BYTE endByte;
    
} Descriptor;

typedef struct 
{
    UINT b1;
    UINT EntryCount;
    UINT b3;
    UINT b4;
    local int i = 0;
    for(i= 0; i < root.EntryCount; i++) {
        CurrentPos = FTell();
        FSeek(CurrentPos + 12);
    }
    string EntryName;
    CurrentPos = FTell();
    FSeek(CurrentPos -1);
    UINT Pad;
    string ClassName;
    
} HKX_Root;

typedef struct {
    short padding;
    uint b1;
    uint b2;
    uint b3;
    uint Skeletons_Count;
    uint b5;
    uint b6;
    short Animations_Count;
    short b7;
    uint b8;
    uint b9;
    uint Bindings_Count;
    uint b11;
    uint b12;
    uint Attachments_Count;
    uint b14;
    uint b15;
    uint Skins_Count;
    uint b17;
} HKX_Block;

typedef struct {
    INT64 num10;
    INT num11;
    local int FinalOffset;
} DescriptorInfo;

typedef struct {
    FLOAT X;
    FLOAT Y;
    FLOAT Z;
    FLOAT W;
} Vec4;

typedef struct {
    BYTE UnknownNull[21];
    BYTE u1;
    BYTE UnknownNull2[11];
    BYTE u2;
    int64 unknownNull3;
    BYTE u3;
    BYTE U4Padding[83];
    LONG u4;
    LONG u5;
    LONG u6;
    LONG u7;
    SHORT u8;
    BYTE U9[16];
    BYTE U10[16];
    LONG null1;
    LONG u11;
    BYTE null2[11];
    LONG u12;
    BYTE null3;
    LONG IndexCount;
    SHORT IndexCount2;
    BYTE Null4;
    LONG u14;
    LONG u15;
    LONG u16;
    LONG u17;
    LONG u18;
    BYTE u19;
    LONG u20;
    LONG u21;
    LONG null5;
} ExtendedMesh_Header;



typedef struct {
    Vec4 Up;
    Vec4 Right;
    Vec4 Forward;
    Vec4 Transform;
} ExtendedMesh_Entry;



typedef struct {
    byte padding[240];
    Vec4 vec4[4000];
    
} hkpExtendedMeshShape;


Junk junk;

HkxHeader header;


local int classDataStart;   //num
local int classFixupOffset; //num2
local int dataDataStart;    //num3
local int dataFixupOffset;  //num4
local int dataExportsOffset;//num5


local int currentSelection; // num6
for (currentSelection = 0; currentSelection < header.NumSections; currentSelection++) {
    Section s;
    if( s.SectionTag == "__classnames__") {
        classDataStart = s.AbsoluteDataStart;
        classFixupOffset = s.GlobalFixupsOffset;
    }
    if( s.SectionTag == "__types__") {
        //Nothing to do here...
    }
    if( s.SectionTag == "__data__") {
        dataDataStart = s.AbsoluteDataStart;
        dataFixupOffset = s.VirtualFixupsOffset;
        dataExportsOffset = s.ExportsOffset;
    }
}
// Go to the first descriptor start
FSeek(StartOffset + classDataStart);

// Run a descriptor and continue to do so until no more are found.
Descriptor descriptor;
while(descriptor.endByte != -1) {
    FSeek(descriptor.pos);
    Descriptor descriptor;
}
FSeek(StartOffset + dataDataStart);
HKX_Root root;
HKX_Block block;
FSeek(StartOffset + dataDataStart + dataFixupOffset);
local int num8 = StartOffset + dataDataStart + dataExportsOffset;

local int offset = 0;


while(FTell() < num8) {
    SetBackColor(cGreen);
    DescriptorInfo info;
    SetBackColor(cBlack);
    info.FinalOffset = StartOffset + dataDataStart + info.num10;
    if(info.num11 != -1 && FTell() < num8 ) {
        offset = FTell();
        
        FSeek(StartOffset + dataDataStart + info.num10);
        SetBackColor(cRed);
        if(info.num11 == 169) {
            ExtendedMesh_Header h;

            local int i = 0;
            
            for(i = 0; i < h.IndexCount; i++) {
                ExtendedMesh_Entry e;
            } 
        } else {
            Vec4 vec;
        }
        SetBackColor(cBlack);
        FSeek(offset);
    }
}



LONG log;