typedef struct
{
	uint32 version;
	ShaderRenderPath path;
	uint32 shaderConstantCount;

	local int shaderConstantCountInt = 0;
	for(shaderConstantCountInt = 0; shaderConstantCountInt < shaderConstantCount; shaderConstantCountInt++) ;
	{
		//byte shaderConstants[size]; // ShaderConstants;
		ShaderConstants shaderConstants; 
	}

	uint32 constantFunctionCount;

	local int constantFunctionCountInt = 0;
	for(constantFunctionCountInt = 0; constantFunctionCountInt < constantFunctionCount; constantFunctionCountInt++) ;
	{
		uint16 size;
		uint16 registerCount;

		local int sizeInt = 0;
		for(sizeInt = 0; sizeInt < size; sizeInt++);
		{
			uint32 function;
			UINT8 index; //UINT8
			UINT8 parameter; //UINT8
			UINT8 arraySize; //UINT8
			UINT8 vectorCount; //UINT8
		}
	}

	uint32 textureFunctionCount;

	local int textureFunctionCountInt = 0;
	for(textureFunctionCountInt = 0; textureFunctionCountInt < textureFunctionCount; textureFunctionCountInt++);
	{
		uint32 textures;

		local int texturesInt = 0;
		for(texturesInt = 0; texturesInt < textures; texturesInt++);
		{
			UINT8 function; //UINT8
			UINT8 valueType; //UINT8
			UINT8 index; //UINT8
			UINT8 parameter; //UINT8
		}
	}

	uint32 vertexShaderCount;
	Shader vertexShaders[vertexShaderCount];

	uint32 pixelShaderCount;
	Shader pixelShaders[pixelShaderCount];

	uint32 geometryShaderCount;
	Shader geometryShaders[geometryShaderCount];

	uint32 hullShaderCount;
	Shader hullShaders[hullShaderCount];

	uint32 domainShaderCount;
	Shader domainShaders[domainShaderCount];

	uint32 solutionCount;
	ShaderSolution solutions[solutionCount];

	uint32 solutionStateCount;
	ShaderSolutionState solutionStates[solutionStateCount];

	uint32 geometryDeclarationCount;
	GeometryDeclaration geometryDeclarations;

	uint32 surfaceShaderSolutionCount;
	SurfaceShaderSolution surfaceShaderSolutions[surfaceShaderSolutionCount];
} ShaderDatabase;


typedef struct
{
	uint32 paths;
	local int pathsInt = 0;
	for(pathsInt = 0; pathsInt < paths; pathsInt++) ;
	{
		ShaderRenderPath path;
		uint32 databaseSize;
		//byte database[pathDatabaseBufferSize]; // ShaderDatabase;
		ShaderDatabase sdb;
	}
} IShaderDatabase;

IShaderDatabase isdb;