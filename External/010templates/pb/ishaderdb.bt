typedef struct
{
	uint32 parameterNameHash;
	uint32 parameterId;
	ShaderTextureCoordType coordType; // (uint32);
	VertexElementUsage vertexUsage; // (uint32);
	float factor;
} ShaderStreamableExternalTexture;

typedef struct
{
	VertexElementUsage usage;
	VertexElementFormat format;
	byte offset;
	byte streamIndex;
} VertexElement;

typedef struct {
	byte stride;
	VertexElementClassification classification;
} VertexStream;

typedef struct 
{
	VertexElement elements;
	VertexStream streams;
	byte elementCount;
	byte streamCount;
	byte padding;

} GeometryDeclarationDesc;

typedef struct
{
	uint32 hash;
	GeometryDeclarationDesc desc;
} GeometryDeclaration;

typedef struct
{
	uint32 nameHash;
	ShaderTextureCoordType coordType; //(uint32);
	VertexElementUsage vertexUsage; // (uint32);
	float factor;
} ShaderStreamableTexture;


typedef struct
{
	uint64 stateHash; // Seems to be (Fletcher32(stateData) | Fletcher32(stateData, starting at offset 16) << 32);
	UINT8 flags; //UINT8
	SurfaceShaderType surfaceType; //(UINT8);
	ShaderBlendMode blendMode; //(UINT8);
	uint32 pad;
	uint32 vertexShaderIndex;
	uint32 pixelShaderIndex;
	uint32 vertexConstantIndex;
	uint32 pixelCOnstantIndex;
} ShaderSolution;


typedef struct
{
	byte guid[16];
	uint32 size;
	byte data[size];

	if (shaderType == Pixel || Vertex || Hull || Domain);
	{
		uint32 constantsIndex;
		uint32 constantFunctionIndex;
		uint32 textureFunctionIndex;
	}

	uint32 signatureDataSize;
	byte signatureData[signatureDataSize];
	uint32 elementSize;
	byte elements[elementSize];
	string elementNames; //vector<string>
	uint32 dxInstructionCount;
} Shader;


typedef struct
{
	byte enable;
	ShaderShadowmapMethod shadowmapMethod; // (UINT8);
	ShaderShadowmapQuality shadowmapQuality; // (UINT8);
	byte transparencyShadowmapEnable;
} OutdoorLightSolutionState;

typedef struct
{
	uint32 surfaceShaderNameHash;
	uint32 vertexShaderFragmentNameHash;
	uint32 geometryDeclarationHash ;
	ShaderRenderMode mode; //(UINT8);
	ShaderGeometrySpace geometrySpace; //(UINT8);
	ShaderSkinningMethod skinningMethod; //(UINT8);
	ShaderInstancingMethod instancingMethod; //(UINT8);
	ShaderObjectLighting objectLighting; //(UINT8);
	UINT8 colorScale;
	UINT8 technique;
	UINT8 boolPermutation;
	UINT8 ps3ClipPlaneCount;
	UINT8 heightfieldTessellation;
	OutdoorLightSolutionState outdoorLight;
	uint16 pad;
	uint32 pad;
} ShaderSolutionState;

typedef struct
{
	uint32 nameHash;

	SurfaceShaderType shaderType;// (uint32);
	UINT8 flags;
	UINT8 boolParameterCount;
	UINT8 boolParameterDefaultMask;
	UINT8 boolParameterRequiredMask;
	;
	local int boolParameterCountInt = 0;
	for(boolParameterCountInt = 0; boolParameterCountInt < boolParameterCount; boolParameterCountInt++);
	{
		uint32 boolParameterId;
	}

	uint32 streamableTextureCount;
	ShaderStreamableTexture streamableTextures[streamableTextureCount];

	uint32 streamableExternalTextureCount;
	ShaderStreamableExternalTexture streamableExternalTextures[streamableExternalTextureCount];

	uint32 solutionIndices;

	local int solutionIndicesInt = 0;
	for(solutionIndicesInt = 0; solutionIndicesInt < solutionIndices; solutionIndicesInt++);
	{
		uint16 index;
	}
} SurfaceShaderSolution;



typedef struct
{
    float Value[4];
} Float4;

typedef struct
{
	uint32 size;
	uint32 valueConstantOffset;
	uint32 textureConstantOffset;
	uint32 externalValueConstantOffset;
	uint32 externalTextureConstantOffset;
	uint16 constantCount;
	uint16 valueConstantStart;
	UINT8 valueConstants;
	UINT8 textureConstants;
	UINT8 externalValueConstants;
	UINT8 externalTextureConstants;
	UINT8 uniqueSamplerStates;
	;
	// Align 16;
	;
	local int valueConstantsInt = 0;
	for(valueConstantsInt = 0; valueConstantsInt < valueConstants; valueConstantsInt++);
	{
		Float4 value;
	}

	local int textureConstantsInt = 0;
	for(textureConstantsInt = 0; textureConstantsInt < textureConstants; textureConstantsInt++);
	{
		UINT8 index;
		TextureType type;// (UINT8);
		uint16 pad0;
		char textureName[128];
		uint64 pad1;
	}

	local int externalValueConstantsInt = 0;
	for(externalValueConstantsInt = 0; externalValueConstantsInt < externalValueConstants; externalValueConstantsInt++);
	{
		char name[32];
		uint32 nameHash; // Fletcher32;
		uint16 index;
		uint16 arraySize;
		UINT8 size;
		UINT8 required;
		uint16 pad;
		Float4 value;
	}

	local int externalTextureConstantsInt = 0;
	for(externalTextureConstantsInt = 0; externalTextureConstantsInt < externalTextureConstants; externalTextureConstantsInt++);
	{
		char name[32];
		uint32 nameHash; // Fletcher32;
		uint16 index;
		TextureType type; // (UINT8);
		byte required;
	}

	local int uniqueSamplerStatesInt = 0;
	for(uniqueSamplerStatesInt = 0; uniqueSamplerStatesInt < uniqueSamplerStates; uniqueSamplerStatesInt++);
	{
		uint32 index;
		D3D11_SAMPLER_DESC desc;
		uint64 padding;
	}
} ShaderConstants;

typedef struct
{
	UINT8 stride;
	VertexElementClassification classification;// (UINT8);
} Element;


