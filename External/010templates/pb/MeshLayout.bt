typedef enum {
    MeshType_Rigid = 0x0,
    MeshType_Skinned = 0x1,
    MeshType_Composite = 0x2,
} MeshType;

typedef enum {
    IsBaseLod = 0x1,
    StreamingEnable = 0x40,
    StreamInstancingEnable = 0x10,
    VertexAnimationEnable = 0x80,
    IsDataAvailable = 0x20000000,
} MeshLayoutFlags;

typedef struct {
    long offset;
    local int pos = FTell();
    FSeek(offset);
    string str;
    FSeek(pos);
} RelocString;

typedef struct {
    long offset;
    local int pos = FTell();
    FSeek(offset);
    uint str;
    FSeek(pos);
} RelocUint;
typedef struct {
    byte usage;
    byte format;
    byte offset;
    byte streamIndex;
} Element;
typedef struct {
    byte stride;
    byte classification;
} Stream;

typedef struct {
    local int i = 0;
    for(i = 0; i < 16; i++) {
        Element e;
    }
    for(i = 0; i < 4; i++) {
        Stream s;
    }
    byte elementCount;
    byte streamCount;
    byte padding[2];
} GeometryDeclarationDesc;


        local int i2;
typedef struct {
    LONG SubsetCount;
