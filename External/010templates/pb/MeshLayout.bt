        int unknown3;
        LONG u1;
        LONG u2;
        LONG u3;
        LONG u4;
        BYTE u5;
    }   
    FSeek(StartPos);
} MeshSubset;


typedef struct {
    LONG offset;
    local int pos = FTell();
    FSeek(offset);
    MeshType meshType;
    local int pos2 = FTell();
    MeshSubset subset;
} MeshLayout;


