//------------------------------------------------
//--- 010 Editor v8.0 Binary Template
//
//      File: .hknodestruction
//   Authors: Powback
//   Version: 1
//   Purpose: To convert HKX files into a readable format.
//  Category: 
// File Mask: *.hknodestruction
//  ID Bytes: 57 E0 E0 57
//   History: 
//------------------------------------------------
LittleEndian();
local int StartOffset = 0;
local int CurrentPos = FTell();
typedef struct {
    UINT CurrentBytes;
    while(CurrentBytes != 0x57E0E057) {
        UINT CurrentBytes;
        StartOffset = FTell();
        StartOffset -= 4;
    }
    FSeek(StartOffset);
} Junk;


typedef struct {
    uint Magic1;
    uint Magic2;
    uint UserTag;
    uint FileVersion;
    uint LayoutRules;
    uint NumSections;
    uint ContentsSectionIndex;
    uint ContentsSectionOffset;
    uint ContentsClassNameSectionIndex;
    uint ContentsClassNameSectionOffset;
    string ContentsVersion;
    BYTE DeLimiter;
    uint Flags;
    uint Padding;
} HkxHeader;

typedef struct {
    BYTE SectionTag[19];
    BYTE NullByte;
    INT32 AbsoluteDataStart;
    INT32 LocalFixupsOffset;
    INT32 GlobalFixupsOffset;
    INT32 VirtualFixupsOffset;
    INT32 ExportsOffset;
    INT32 ImportsOffset;
    INT32 EndOffset;

} Section;

typedef struct 
{
    local int key = FTell() - StartOffset - classDataStart + 5;
    LONG Signature; // We need to store this
    BYTE Version;
    string Name;
    local int64 pos = FTell();
    BYTE endByte;
    
} Descriptor;

typedef struct 
{
    UINT b1;
    UINT EntryCount;
    UINT b3;
    UINT b4;
    local int i = 0;
    for(i= 0; i < root.EntryCount; i++) {
        CurrentPos = FTell();
        FSeek(CurrentPos + 12);
    }
    string EntryName;
    CurrentPos = FTell();
    FSeek(CurrentPos -1);
    UINT Pad;
    string ClassName;
    
} HKX_Root;

typedef struct {
    INT64 num10;
    INT num11;
    local int FinalOffset;
} DescriptorInfo;

typedef struct {
    //Vec4
    FLOAT TransX;
    FLOAT TransY;
    FLOAT TransZ;
    FLOAT TransW;
    //ROT
    FLOAT RotX;
    FLOAT RotY;
    FLOAT RotZ;
    //Scale
    FLOAT ScaleX;
    FLOAT ScaleY;
    FLOAT ScaleZ;
    FLOAT ScaleW;
}  HavokPhysicsContainer;
Junk junk;

HkxHeader header;


local int classDataStart;   //num
local int classFixupOffset; //num2
local int dataDataStart;    //num3
local int dataFixupOffset;  //num4
local int dataExportsOffset;//num5


local int currentSelection; // num6
for (currentSelection = 0; currentSelection < header.NumSections; currentSelection++) {
    Section s;
    if( s.SectionTag == "__classnames__") {
        classDataStart = s.AbsoluteDataStart;
        classFixupOffset = s.GlobalFixupsOffset;
    }
    if( s.SectionTag == "__types__") {
        //Nothing to do here...
    }
    if( s.SectionTag == "__data__") {
        dataDataStart = s.AbsoluteDataStart;
        dataFixupOffset = s.VirtualFixupsOffset;
        dataExportsOffset = s.ExportsOffset;
    }
}
// Go to the first descriptor start
FSeek(StartOffset + classDataStart);

// Run a descriptor and continue to do so until no more are found.
Descriptor descriptor;
while(descriptor.endByte != -1) {
    FSeek(descriptor.pos);
    Descriptor descriptor;
}
FSeek(StartOffset + dataDataStart);
HKX_Root root;
FSeek(StartOffset + dataDataStart + dataFixupOffset);
local int num8 = StartOffset + dataDataStart + dataExportsOffset;

local int offset = 0;
typedef struct {
    float X;
    float Y;
    float Z;
    float W;
} Vec4;

while(FTell() < num8) {
    DescriptorInfo info;
    info.FinalOffset = StartOffset + dataDataStart + info.num10;
    if(info.num11 != -1 && FTell() < num8 ) {
        offset = FTell();
        
        FSeek(StartOffset + dataDataStart + info.num10);
        Vec4 vec;
        FSeek(offset);
    }
}
LONG log;