<UserControl x:Class="Rime.Controls.ContentBrowser.ContentBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Rime.Controls.ContentBrowser"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
            <Button x:Name="btnAddContent" Content="Add"/>
            <Button x:Name="btnImport" Content="Import"/>
            <Button x:Name="btnSaveAll" Content="Save All"/>
            <Button x:Name="btnNavigateUp" Content="&lt;"/>
            <Button x:Name="btnNavigateFoward" Content="&gt;"/>
            <TextBox x:Name="txtContentPath" Width="300"/>
        </StackPanel>
        <Grid x:Name="gridContentBrowser">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TreeView x:Name="tvContentFolders"/>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Black" ShowsPreview="True" Width="5"/>
            <ListView x:Name="lstContentItems" Grid.Column="2"/>
        </Grid>
    </DockPanel>
    
</UserControl>
